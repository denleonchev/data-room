// Auth models below are generated by Better Auth's CLI, not written by hand:
//   pnpm dlx auth@latest generate --adapter prisma --dialect postgresql
// Its Prisma adapter looks these table and field names up by convention — edit
// them through the generator, not directly.
//
// The Node / Share models below are ours — see docs/architecture.md for the
// data model and its rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  nodes         Node[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum NodeType {
  FOLDER
  FILE
}

enum ShareMode {
  PUBLIC_LINK
  RESTRICTED
}

enum ShareRole {
  VIEWER
}

enum FileStatus {
  PENDING
  READY
}

// A node without a parent is a Data Room. Prisma can't express the partial
// unique index that keeps it to one per user — it is in the migration by hand.
model Node {
  id         String      @id @default(uuid(7))
  type       NodeType
  name       String
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Node?       @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   Node[]      @relation("NodeChildren")
  // Ids of every ancestor, "/roomId/legalId/", kept in step with parentId by
  // the node service. Its index needs text_pattern_ops, which Prisma can't
  // express — it is in the migration by hand.
  path       String
  // File-only columns (slice 3): empty on folder rows, same tradeoff as the
  // one-table design already takes elsewhere.
  size       Int?
  mimeType   String?
  storageKey String?     @unique
  status     FileStatus?
  shares     Share[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // The leading column also serves listing a folder's children, so parentId
  // needs no index of its own.
  @@unique([parentId, name])
  @@index([ownerId])
  @@map("node")
}

model Share {
  id           String    @id @default(uuid(7))
  nodeId       String
  node         Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  mode         ShareMode
  role         ShareRole @default(VIEWER)
  // Only public links carry a token; restricted shares identify their grantee.
  token        String?   @unique
  // Only restricted shares carry this — resolved against the caller's session
  // email at read time (slice 7's logic PR), not a stored user link. Same
  // resolve-lazily-on-read choice the Data Room's own creation already makes.
  granteeEmail String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // The leading column also serves nodeId-only lookups, so no separate index
  // for it — same reasoning Node's own (parentId, name) index already uses.
  // NULLs don't collide in a unique index, so this only constrains restricted
  // shares (one grantee per node), never public links.
  @@unique([nodeId, granteeEmail])
  @@map("share")
}
