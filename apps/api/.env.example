# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (Supabase Postgres). DATABASE_URL is the pooled connection (used at
# runtime through the Prisma driver adapter), DIRECT_URL is the non-pooled one
# that Migrate reads via prisma.config.ts.
DATABASE_URL=
DIRECT_URL=

# Auth. BETTER_AUTH_SECRET signs sessions — any random 32+ char string
# (openssl rand -base64 32). BETTER_AUTH_URL is this API's own public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Optional locally — without them Google sign-in isn't registered, email/password
# still works. Redirect URI to whitelist: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shares the session cookie across data.bonadev.xyz and api.data.bonadev.xyz.
# Leave empty on localhost: a dotted domain makes the browser drop the cookie.
COOKIE_DOMAIN=

# File storage (Supabase Storage). SUPABASE_URL shares the project ref with
# DATABASE_URL above (https://<ref>.supabase.co) — not a separate secret to
# find. SUPABASE_SERVICE_ROLE_KEY: dashboard → Project Settings → API →
# Project API keys → service_role (server-side only, never shipped to the
# client). SUPABASE_STORAGE_BUCKET: a private bucket created under Storage —
# "Public bucket" must stay off, authorization lives in Postgres, not bucket
# policy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
