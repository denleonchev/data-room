# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (Supabase Postgres). DATABASE_URL is the pooled connection (used at
# runtime through the Prisma driver adapter), DIRECT_URL is the non-pooled one
# that Migrate reads via prisma.config.ts.
DATABASE_URL=
DIRECT_URL=

# Auth. BETTER_AUTH_SECRET signs sessions — any random 32+ char string
# (openssl rand -base64 32). BETTER_AUTH_URL is this API's own public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Optional locally: without these two, Google sign-in is simply not registered
# and email/password still works. Redirect URI to whitelist in Google Cloud
# Console: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional locally, required in production: shares the session cookie across
# data.bonadev.xyz and api.data.bonadev.xyz. Leave empty on localhost, where a
# dotted domain would make the browser drop the cookie.
COOKIE_DOMAIN=
